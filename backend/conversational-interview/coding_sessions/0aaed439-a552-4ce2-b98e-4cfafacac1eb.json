          "language": "python",
          "code": "def length_of_longest_substring(s: str) -> int:\n    seen = {}\n    left = 0\n    max_length = 0\n\n    for right in range(len(s)):\n        if s[right] in seen and seen[s[right]] >= left:\n            left = seen[s[right]] + 1\n\n        seen[s[right]] = right\n\n        max_length = max(max_length, right - left + 1)\n\n    return max_length",
