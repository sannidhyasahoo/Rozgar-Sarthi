        {
          "id": "4dbb8788-06b1-4dcc-996c-668da4dd86e7",
          "questionId": "number-of-islands",
          "attemptNumber": 1,
          "language": "python",
          "code": "def num_islands(grid: list[list[str]]) -> int:\n    rows = len(grid)\n    cols = len(grid[0])\n    islands = 0\n\n    def dfs(r, c):\n        # Out of bounds or water\n        if r < 0 or r >= rows or c < 0 or c >= cols or grid[r][c] == \"0\":\n            return\n\n        # Mark as visited\n        grid[r][c] = \"0\"\n\n        # Explore 4 directions\n        dfs(r + 1, c)\n        dfs(r - 1, c)\n        dfs(r, c + 1)\n        dfs(r, c - 1)\n\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == \"1\":\n                islands += 1\n                dfs(r, c)\n\n    return islands",
